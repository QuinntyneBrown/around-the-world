@startuml
title UML sequence behaviour — Scale the detail back
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — world" #E0F2FE
  participant "ThreeClassroomRenderer" as renderer
  participant "QualityScaler" as scaler
  participant "ClassroomScene" as scene
end box
loop each animation frame
  renderer -> scaler : frame(ms since the last frame)
  alt a gap of more than a second (the page was hidden)
    scaler -> scaler : Start a new 2-second window
  else the window is not yet 2 seconds long
    scaler -> scaler : Keep counting frames
  else 2 seconds measured at 30 or more frames a second, or the last step
    scaler -> scaler : Start a new window
  else 2 seconds measured below 30 frames a second (L2-036 criterion 4)
    scaler --> renderer : The next step (docs/adr/0028)
    renderer -> renderer : Set the resolution; shadow map on or off; keep the step for the next screen
    renderer -> scene : applyStep(step): blob shadows or shadow map, small decorations
    scene --> renderer : Detail scaled back
    scaler -> scaler : Start a new window
  end
  renderer -> scene : Draw the frame
  scene --> renderer : Frame drawn
end
@enduml
