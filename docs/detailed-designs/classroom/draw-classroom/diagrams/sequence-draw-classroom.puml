@startuml
title UML sequence behaviour — Draw the classroom on a screen
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Child" as actor
box "Frontend — game" #E0F2FE
  participant "HomePage, DuelPage or WorldMapPage" as screen
  participant "ClassroomBackdrop" as backdrop
end box
box "Frontend — world" #E0F2FE
  participant "ThreeClassroomRenderer" as renderer
  participant "ClassroomScene" as scene
  participant "KidCharacter" as kid
end box
participant "Game's own origin" as origin
actor -> screen : Open Home, Duel or World Map (L2-036 criterion 6)
screen -> backdrop : Place with ClassroomState and the view: behind, or from above
backdrop -> origin : Request the still picture
origin --> backdrop : Still picture
backdrop --> actor : Still picture on Home and Duel, skeleton and "Drawing the classroom…" on World Map; the interface is usable (L2-036 criterion 2)
backdrop -> origin : Import the world chunk through CLASSROOM_RENDERER
alt the device draws the 3D classroom
  origin --> backdrop : ThreeClassroomRenderer
  backdrop -> renderer : mount(canvas, view)
  renderer -> scene : load()
  scene -> origin : Request scenes, same origin (L2-036 criterion 5)
  origin --> scene : Ring of desks, landmarks
  scene -> kid : Create each kid with colour and animations, Bolt with Milo; beans on World Map, further classmates plain (L2-037)
  kid --> scene : Kids in idle
  scene --> renderer : Scene ready
  renderer -> renderer : Start the animation loop
  renderer --> backdrop : Mounted
  backdrop -> renderer : show(state)
  backdrop --> actor : 3D classroom fades in (L2-036 criterion 1)
else no WebGL, or the chunk or a scene fails to load
  renderer --> backdrop : Rejected
  backdrop --> screen : status = still
  screen --> actor : Still picture stands in; Home and World Map say so in words; game playable (L2-036 criterion 3)
end
actor -> screen : Leave the screen
screen -> backdrop : Destroy
backdrop -> renderer : dispose()
renderer -> scene : Stop the loop; dispose geometries, materials, textures (L2-048 criterion 3)
scene --> renderer : Disposed
renderer --> backdrop : Renderer disposed
@enduml
