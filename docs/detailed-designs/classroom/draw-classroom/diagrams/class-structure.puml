@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Draw the classroom

interface ClassroomRenderer {
  +mount(canvas: HTMLCanvasElement): Promise<void>
  +show(state: ClassroomState, view: ClassroomView): void
  +dispose(): void
}
enum KidAnimation {
  idle
  thinking
  hop
  winCheer
  soClose
}
enum ClassroomView {
  behind
  fromAbove
  fromAboveZoomed
}
class ClassroomState {
  +desks: ClassroomDesk[]
  +figures: ClassroomFigure[]
  +focusDesk: number | null
}
class ClassroomDesk {
  +desk: number
  +country: string
  +lit: boolean
}
class ClassroomFigure {
  +id: string
  +kid: KidId | "classmate"
  +desk: number
  +travelling: boolean
  +you: boolean
  +animation: KidAnimation
  +from: ClassroomSpot | null
}
class ThreeClassroomRenderer {
  -renderer: WebGLRenderer
  -frame: number
  +mount(canvas): Promise<void>
  +show(state, view): void
  +dispose(): void
}
class ClassroomScene {
  +show(state: ClassroomState): void
  +update(seconds, still, facing): void
  +applyStep(step: QualityStep): void
  +dispose(): void
}
class KidCharacter {
  +kid: KidId | "classmate"
  +place(point): void
  +hopTo(point): void
  +play(animation: KidAnimation): void
  +dispose(): void
}
class QualityScaler {
  -elapsed: number
  -frames: number
  +step: QualityStep
  +frame(ms: number): boolean
}
class ClassroomCanvas <<directive>> {
  +state: ClassroomState | null
  +view: "behind" | "fromAbove"
  +status: output<"drawn" | "still">
}
class ClassroomStates <<domain>> {
  +atRest(): ClassroomState
  +ofTour(tour, duel?): ClassroomState
}

ClassroomRenderer <|.. ThreeClassroomRenderer
ClassroomCanvas --> ClassroomRenderer : loads, mounts, disposes
ThreeClassroomRenderer *-- ClassroomScene
ThreeClassroomRenderer *-- QualityScaler
ClassroomScene *-- "0..*" KidCharacter
ClassroomState *-- "6, 12 or 24" ClassroomDesk
ClassroomState *-- "0..*" ClassroomFigure
ClassroomStates ..> ClassroomState : makes
ClassroomRenderer ..> ClassroomState
KidCharacter ..> KidAnimation : plays
ClassroomCanvas --> ClassroomView
@enduml
