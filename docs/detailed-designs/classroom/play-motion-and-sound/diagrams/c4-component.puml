@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Play motion and sound

Container_Boundary(game, "game application") {
  Component(moments, "MomentSounds", "Service of the solo group", "Plays a sound for each moment")
  Component(pages, "DuelPage, HomePage, SettingsDialog", "Pages and dialog", "Pop on a key; the sound button and the Sound switch")
}
Container_Boundary(domain, "domain library — tour/, sound/ and storage/") {
  Component(session, "SoloGame", "Service behind GAME_SESSION", "Reports answerCorrect and countryReached")
  Component(sound, "BrowserSound", "Implementation behind SOUND", "Pop, chime, jingle; silent while muted or before the first touch")
  Component(choices, "StoredPlayerChoices", "Store behind PLAYER_CHOICES", "Keeps the mute on the device")
}
Container_Boundary(components, "components library") {
  Component(card, "FlashCard, StampCard, Podium", "Presentation components", "Card flip, shake, stamp and rise, or a quick fade")
}
Container_Boundary(world, "world library") {
  Component(renderer, "ThreeClassroomRenderer and KidCharacter", "Implementation behind CLASSROOM_RENDERER", "The hop along the path, or a fade, win cheer, so close")
}
Rel(moments, session, "watchMoments")
Rel(moments, sound, "play(chime | jingle)")
Rel(pages, sound, "play(pop)")
Rel(pages, choices, "soundMuted, setSoundMuted")
Rel(sound, choices, "Reads soundMuted")
Rel(pages, card, "Bind the state shown")
Rel(pages, renderer, "show(state)")
@enduml
