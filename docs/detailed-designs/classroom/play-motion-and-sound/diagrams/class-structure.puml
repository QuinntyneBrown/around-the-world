@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Play motion and sound

enum GameMoment {
  answerCorrect
  countryReached
}
enum SoundId {
  pop
  chime
  jingle
}
interface GameSession {
  +watchMoments(listener: (moment: GameMoment) => void): () => void
}
class SoloGame {
  -moments: Set<listener>
  -report(moment: GameMoment): void
}
interface Sound {
  +play(sound: SoundId): void
}
class BrowserSound {
  -players: Map<SoundId, HTMLAudioElement> | null
  +play(sound: SoundId): void
  -touched(): boolean
  -release(): void
}
interface PlayerChoices {
  +soundMuted: Signal<boolean>
  +setSoundMuted(muted: boolean): void
}
class StoredPlayerChoices
class MomentSounds {
  -stop: () => void
}
class DuelPage {
  #press(key: PadKey): void
}
class HomePage {
  #muted: Signal<boolean>
  #toggleSound(): void
}
class SettingsDialog {
  #soundOn: Signal<boolean>
  #turnSound(on: boolean): void
}

GameSession <|.. SoloGame
Sound <|.. BrowserSound
PlayerChoices <|.. StoredPlayerChoices
SoloGame ..> GameMoment : reports
BrowserSound --> PlayerChoices : reads the mute
BrowserSound ..> SoundId
MomentSounds --> GameSession : watches moments
MomentSounds --> Sound : plays chime, jingle
DuelPage --> Sound : plays pop
HomePage --> PlayerChoices : sound button
SettingsDialog --> PlayerChoices : "Sound" switch
@enduml
