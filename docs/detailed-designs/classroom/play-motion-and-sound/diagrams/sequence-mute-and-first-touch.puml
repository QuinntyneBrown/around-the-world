@startuml
title UML sequence behaviour — Mute and the first touch
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Child" as actor
box "Frontend — game" #E0F2FE
  participant "HomePage or SettingsDialog" as home
  participant "DuelPage" as duel
end box
box "Frontend — domain" #E0F2FE
  participant "StoredPlayerChoices" as choices
  participant "BrowserSound" as sound
end box
actor -> home : Open the game
home -> choices : Read soundMuted
choices --> home : Sound setting as the child left it (L2-015 criterion 3)
home --> actor : "Mute sound", or "Turn sound on" while muted; no sound before a touch (L2-039 criterion 3)
opt child presses the sound button, or changes "Sound" in Settings
  actor -> home : Sound button, or the "Sound" switch (L2-032 criteria 3 and 4)
  home -> choices : setSoundMuted(not muted)
  choices --> home : Kept on the device
  home --> actor : Label reads "Mute sound" or "Turn sound on"; the switch reads On or Off
end
actor -> duel : A key of the number pad
duel -> sound : play(pop)
sound -> choices : Read soundMuted
alt muted, or the browser records no touch yet
  sound -> sound : Play nothing (L2-039 criteria 2 and 3)
else sound is on
  sound -> sound : Make the three audio elements on the first sound
  sound --> actor : Pop (L2-039 criterion 1)
end
@enduml
