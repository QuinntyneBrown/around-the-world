@startuml
title UML sequence behaviour — Sit down after a duel is lost
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Child" as actor
box "Frontend — game" #E0F2FE
  participant "SoloGame" as session
  participant "DuelPage" as duel
  participant "WorldMapPage" as map
end box
box "Frontend — world" #E0F2FE
  participant "ThreeClassroomRenderer" as renderer
end box
session --> duel : Duel lost: the rival answered first; no moment, so no sound
duel -> renderer : show(state): the kid plays soClose
duel --> actor : "{rival} said {answer} first. So close!"; no red screen, no buzzer (L2-038 criterion 3)
actor -> duel : Choose "You sit at {country} · {rival} travels on" (L2-033 criterion 8)
duel -> session : continue()
session --> map : World Map opens on the move
map -> renderer : show(state): the beaten traveller at the desk, the desk holder hops on
alt full motion
  renderer --> actor : The new traveller walks along the path in 1.4 seconds
else the device asks for reduced motion
  renderer --> actor : A fade of 200 ms to the new positions (L2-038 criterion 4)
end
map --> actor : "So close! You sit down at {country}" (L2-034 criterion 4)
@enduml
