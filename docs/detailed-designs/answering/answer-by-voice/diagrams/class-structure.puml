@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Answer by voice

interface VoiceAnswer {
  +available: boolean
  +requestMicrophone(): Promise<MicrophoneAnswer>
  +start(): void
  +stop(): void
  +listen(listener: VoiceListener): () => void
}
interface VoiceListener {
  +heard(value: number): void
  +heardSpeech(): void
  +noSpeech(): void
  +failed(error: VoiceError): void
}
class VoiceError {
  +code: 'refused' | 'failed'
}
class LazyVoiceAnswer {
  -loaded: SpeechVoiceAnswer | null
  -wanted: boolean
}
class SpeechVoiceAnswer {
  -recognition: SpeechRecognition | null
  +start(): void
  +stop(): void
  -onResult(transcript: string): void
  -onError(error: string): void
}
class spokenNumber <<function>> {
  +spokenNumber(transcript: string): number | null
}
interface WayOfAnswering {
  +kept: Signal<AnswerWay>
  +way: Signal<AnswerWay>
  +voiceOffered: Signal<boolean>
  +micCheckNeeded: Signal<boolean>
  +use(way: AnswerWay): void
  +finishMicCheck(outcome: MicCheckOutcome): void
  +loseVoice(): void
}
class KeptWayOfAnswering
interface PlayerChoices {
  +wayOfAnswering: Signal<AnswerWay>
  +changeWayOfAnswering(way: AnswerWay): void
}
interface Visit {
  +micCheckDone: Signal<boolean>
  +voiceLost: Signal<boolean>
}
enum AnswerWay {
  voice
  numberPad
}
interface GameSession {
  +duel: Signal<DuelState>
  +answer(value: number): void
}
class DuelPage {
  -way: WayOfAnswering
  -session: GameSession
  -mayAnswer: Signal<boolean>
  -failedDuel: Signal<string | null>
  #useNumberPad(): void
  #shoutInstead(): void
}
class Listening <<directive [atwListening]>> {
  +heard: output<number>
  +failed: output<VoiceError>
}

LazyVoiceAnswer ..|> VoiceAnswer
LazyVoiceAnswer ..> SpeechVoiceAnswer : imports dynamically
SpeechVoiceAnswer ..|> VoiceAnswer
SpeechVoiceAnswer ..> spokenNumber : parses with
VoiceAnswer ..> VoiceListener : tells
VoiceListener ..> VoiceError
DuelPage *-- Listening : on the "Shout it!" pill
Listening ..> VoiceAnswer : injects VOICE_ANSWER
DuelPage ..> GameSession : injects GAME_SESSION
DuelPage ..> WayOfAnswering : injects WAY_OF_ANSWERING
KeptWayOfAnswering ..|> WayOfAnswering
KeptWayOfAnswering --> AnswerWay
KeptWayOfAnswering ..> PlayerChoices : keeps the way on the device through
KeptWayOfAnswering ..> Visit : remembers the visit through
@enduml
