@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Answer by voice

Person(child, "Child", "The device's player")
Container_Boundary(game, "game (Angular application and its libraries)") {
  Component(page, "DuelPage", "Page, game application", "Starts and stops listening and offers the switch between voice and the number pad")
  Component(way, "WayOfAnswering", "Service, game application", "Holds voice or number pad and keeps it on the device")
  Component(choices, "PlayerChoices (PLAYER_CHOICES)", "Contract and token, api library", "Store of what is kept on the device")
  Component(settings, "Settings dialog", "CDK Dialog, game application", "Offers the switch Answer by shouting")
  Component(session, "GameSession (GAME_SESSION)", "Contract and token, api library", "Says whether the player may answer and takes the answer as a number")
  Component(voice, "VoiceAnswer (VOICE_ANSWER)", "Contract and token, api library", "Start, stop, heard numbers and failures")
  Component(speech, "SpeechVoiceAnswer", "Implementation, domain voice/", "The only code that touches the microphone and speech recognition")
  Component(parser, "spokenNumber", "Pure function, domain voice/", "Reads a transcript as a whole number from 0 to 999, or nothing")
  Component(pad, "NumberPad", "Presentation, components library", "The fallback way of answering")
}
Container_Ext(sr, "Speech recognition", "Browser", "Optional")
Rel(child, page, "Shouts the answer at")
Rel(page, session, "Reads DuelState from and sends the number to")
Rel(page, way, "Reads and changes the way of answering in")
Rel(page, voice, "Starts and stops; subscribes to heard and failed")
Rel(speech, voice, "Implements")
Rel(speech, parser, "Parses each transcript with")
Rel(speech, sr, "Starts, stops and reads results from", "Web Speech API")
Rel(page, pad, "Shows instead of voice")
Rel(way, choices, "Reads and keeps the way of answering through")
Rel(settings, way, "Changes the way of answering in")
Rel(child, settings, "Switches Answer by shouting in")
@enduml
