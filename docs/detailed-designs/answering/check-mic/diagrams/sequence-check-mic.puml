@startuml
title UML sequence behaviour — Check the microphone before the first duel
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Child" as child
box "Frontend — game application" #E0F2FE
  participant "GameSetupPage" as setup
  participant "micCheckGuard" as guard
  participant "MicCheckPage" as page
  participant "WayOfAnswering" as way
  participant "DuelPage" as duel
end box
box "Frontend — domain library" #E0F2FE
  participant "SoloGame\n(GameSession)" as solo
  participant "LazyVoiceAnswer and\nSpeechVoiceAnswer (VoiceAnswer)" as voice
end box
participant "Speech recognition\n(browser)" as sr
child -> setup : "Go!" in a solo game (the host's "Start the race"\non each device in a game with friends, L2-012 criterion 9)
setup -> way : micCheckNeeded()
alt no speech recognition on the device (L2-012 criterion 5)
  way --> setup : false, way is numberPad
  setup -> solo : start(setup), the first card is dealt
  setup -> duel : Open Duel, Mic Check is skipped
else Mic Check done in this visit, or the number pad kept (L2-012 criteria 6 and 13)
  way --> setup : false
  setup -> solo : start(setup), the first card is dealt
  setup -> duel : Open Duel, Mic Check is not shown
else Mic Check needed
  way --> setup : true
  setup -> solo : start(setup, micCheck), no card is dealt yet
  setup -> guard : Open /mic
  guard -> solo : screen() is "mic-check"
  guard -> page : Open Mic Check
  page --> child : Asks to turn on the mic; "your voice is never\nsaved or sent to anyone" (L2-012 criterion 1)
  alt "Turn on mic", allowed (L2-012 criterion 2)
    child -> page : Choose "Turn on mic"
    page -> voice : requestMicrophone()
    voice -> sr : Ask the child for the microphone
    page --> child : "Say yes to the mic", the button is busy:\n"Waiting for the mic…" (L2-012 criterion 10)
    sr --> voice : Allowed
    voice --> page : allowed
    page -> voice : listen(listener), start()
    page --> child : Listening: shout "Ready!"
    opt the browser reports no speech (L2-012 criterion 11)
      voice --> page : noSpeech
      page --> child : "Bolt didn't catch that", "Try again"
      child -> page : Choose "Try again"
      page --> child : Listening again
    end
    child -> sr : "Ready!"
    sr --> voice : Speech heard
    voice --> page : heardSpeech
    page --> child : Heard, "Let's go!" is offered
    child -> page : Choose "Let's go!"
    page -> way : finishMicCheck(heard), voice is kept on the device (L2-015 criterion 4)
  else "Turn on mic", refused (L2-012 criteria 3 and 7)
    child -> page : Choose "Turn on mic"
    page -> voice : requestMicrophone()
    voice -> sr : Ask the child for the microphone
    sr --> voice : Refused
    voice --> page : refused
    page --> child : "Bolt can't hear you", ask a grown-up;\n"Use number pad" is the only choice besides Back
    child -> page : Choose "Use number pad"
    page -> way : finishMicCheck(refused), the number pad for this visit
  else speech recognition fails on the device (L2-012 criterion 12)
    voice --> page : failed
    page --> child : Alert "Bolt's ears aren't working";\n"Use number pad" is the only choice besides Back
    child -> page : Choose "Use number pad"
    page -> way : finishMicCheck(failed), the number pad for this visit
  else "Too noisy? Tap answers instead" (L2-012 criterion 4)
    child -> page : Choose it while asking, waiting or listening
    page -> way : finishMicCheck(numberPad), the number pad is kept on the device
  end
  page -> voice : stop(), release the microphone (L2-040 criterion 2)
  voice -> sr : Stop recognition
  page -> solo : continue(): the first card is dealt and its time starts (L2-012 criterion 8)
  solo --> duel : The game moves to Duel, which opens
end
duel --> child : The first flash card appears
@enduml
