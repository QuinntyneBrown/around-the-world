@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Check the microphone

Person(child, "Child", "A player aged 10 to 12 playing a solo game on the device")
System_Boundary(atw, "Around the World") {
  Container(game, "game", "Angular application", "Holds Mic Check and decides the way of answering before the first duel")
}
Container_Ext(sr, "Speech recognition", "Browser", "Asks the child for the microphone and hears speech, optional")
Rel(child, game, "Allows or refuses the microphone in", "Browser")
Rel(game, sr, "Asks for the microphone and listens through", "Web Speech API")
@enduml
