@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Check the microphone

interface VoiceAnswer {
  +available: boolean
  +requestMicrophone(): Promise<MicrophoneAnswer>
  +start(): void
  +stop(): void
  +listen(listener: VoiceListener): () => void
}
enum MicrophoneAnswer {
  allowed
  refused
  failed
}
interface WayOfAnswering {
  +way: Signal<AnswerWay>
  +voiceOffered: Signal<boolean>
  +micCheckNeeded: Signal<boolean>
  +use(way: AnswerWay): void
  +finishMicCheck(outcome: MicCheckOutcome): void
}
enum MicCheckOutcome {
  heard
  numberPad
  refused
  failed
}
class KeptWayOfAnswering
enum AnswerWay {
  voice
  numberPad
}
enum MicCheckStep {
  asking
  waiting
  listening
  notHeard
  heard
  refused
  failed
}
class MicCheckPage {
  -voice: VoiceAnswer
  -way: WayOfAnswering
  +step: Signal<MicCheckStep>
  +onTurnOnMic(): void
  +onTryAgain(): void
  +onLetsGo(): void
  +onUseNumberPad(): void
  +onBack(): void
}
class micCheckGuard <<function>> {
  +micCheckGuard(): boolean | UrlTree
}
class LazyVoiceAnswer
class SpeechVoiceAnswer {
  +requestMicrophone(): Promise<MicrophoneAnswer>
  +start(): void
  +stop(): void
}

LazyVoiceAnswer ..|> VoiceAnswer
LazyVoiceAnswer ..> SpeechVoiceAnswer : imports dynamically
SpeechVoiceAnswer ..|> VoiceAnswer
KeptWayOfAnswering ..|> WayOfAnswering
WayOfAnswering ..> MicCheckOutcome
VoiceAnswer ..> MicrophoneAnswer : answers
MicCheckPage ..> VoiceAnswer : injects VOICE_ANSWER
MicCheckPage --> WayOfAnswering
MicCheckPage --> MicCheckStep
micCheckGuard ..> GameSession : reads screen, "mic-check"
interface GameSession {
  +screen: Signal<GameScreen>
  +continue(): void
}
MicCheckPage ..> GameSession : continue() deals the first card
WayOfAnswering --> AnswerWay
WayOfAnswering ..> VoiceAnswer : reads available
@enduml
