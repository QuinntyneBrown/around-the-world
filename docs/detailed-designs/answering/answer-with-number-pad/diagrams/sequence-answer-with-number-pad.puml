@startuml
title UML sequence behaviour — Answer a flash card with the number pad
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Child" as child
box "Frontend — components library" #E0F2FE
  participant "NumberPad" as pad
  participant "FlashCard" as card
end box
box "Frontend — game application" #E0F2FE
  participant "DuelPage" as page
  participant "NumberEntry" as entry
end box
box "Frontend — domain library" #E0F2FE
  participant "SoloGame\n(GameSession)" as solo
end box
child -> pad : Press 2 (or type 2 on a keyboard, L2-010 criterion 5)
pad --> page : keyPress 2
page -> entry : add("", 2)
entry --> page : "2"
page -> card : answer "2", shown within 100 ms (L2-049 criterion 1)
child -> pad : Press 4
pad --> page : keyPress 4
page -> entry : add("2", 4)
entry --> page : "24"
page -> card : answer "24" (L2-010 criterion 1)
opt a fourth digit (L2-010 criterion 2)
  child -> pad : Press a digit with three entered
  pad --> page : keyPress digit
  page -> entry : add(entry, digit)
  entry --> page : Unchanged
end
opt Delete or Backspace (L2-010 criterion 3)
  child -> pad : Press Delete
  pad --> page : keyPress delete
  page -> entry : removeLast(entry)
  entry --> page : One digit fewer
end
child -> pad : Press Go (or Enter)
pad --> page : keyPress go
page -> entry : value(entry)
alt no digit entered (L2-010 criterion 4)
  entry --> page : null
  page -> page : No answer is given
else digits entered
  entry --> page : 24
  page -> page : The entry empties
  page -> solo : answer(24)
  alt correct
    solo --> page : DuelState, outcome won
  else wrong (L2-004)
    solo --> page : DuelState, frozen true, wrongAnswer 24
    page -> card : answer "24" frozen, "Not 24! Frozen for a sec…" (L2-004 criterion 5)
    page -> pad : disabled true for 1 s
    opt a key while frozen (L2-010 criterion 6)
      child -> pad : Press or type a key
      pad -> pad : No key is emitted
    end
    solo --> page : DuelState, frozen false
    page -> pad : disabled false
    page -> card : answer "", the entry is empty (L2-010 criterion 7)
  end
end
@enduml
