@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Answer with the number pad

class NumberPad {
  +disabled: InputSignal<boolean>
  +keyPress: Output<PadKey>
  #press(key: PadKey): void
  #onKey(event: KeyboardEvent): void
}
enum PadKey {
  digit 0 to 9
  delete
  go
}
class NumberEntry <<helper>> {
  +{static} MAX_DIGITS = 3
  +{static} add(entry: string, digit: number): string
  +{static} removeLast(entry: string): string
  +{static} value(entry: string): number | null
}
class FlashCard <<component>> {
  +sum: InputSignal<string>
  +answer: InputSignal<string | null>
  +frozen: InputSignal<boolean>
}
interface GameSession {
  +duel: Signal<DuelState | null>
  +answer(value: number): void
}
class DuelPage {
  -session: GameSession
  -typed: Signal<{card, digits}>
  #entry: Signal<string>
  #press(key: PadKey): void
}

NumberPad ..> PadKey : emits
DuelPage --> NumberPad : binds disabled, listens to keyPress
DuelPage ..> NumberEntry : keeps the entry with
DuelPage --> FlashCard : binds answer
DuelPage ..> GameSession : injects GAME_SESSION
@enduml
