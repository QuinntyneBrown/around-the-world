@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Operate the backend

package "Backend — AroundTheWorld.Application" {
  class ErrorCodes <<static>> {
    +RoomNotFound = "room_not_found"
    +RoomFull = "room_full"
    +GameStarted = "game_started"
    +RateLimited = "rate_limited"
    +ServerError = "server_error"
  }
  class RefusedException {
    +string Code
    +int Status
  }
  class "TelemetryBehavior<TRequest, TResponse>" as TelemetryBehavior {
    +Handle(request, next): Task<TResponse>
  }
  class RequestTelemetry {
    +ActivitySource Source
    +Record(request, outcome, duration): void
  }
  interface IRoomNotifier {
    +NotifyRoom(roomId, roomEvent): Task
  }
  interface IReadinessProbe {
    +IsReadyAsync(): Task<bool>
  }
  class CheckReadinessQuery
  class CheckReadinessQueryHandler {
    +Handle(query): Task<bool>
  }
}
package "Backend — AroundTheWorld.Infrastructure" {
  class HubRoomNotifier {
    -IHubContext<RoomHub> hub
    +NotifyRoom(roomId, roomEvent): Task
  }
  class RoomStoreProbe
  class TelemetryScrubber {
    +Spans.OnEnd(activity): void
    +LogRecords.OnEnd(logRecord): void
  }
}
package "Backend — AroundTheWorld.Api" {
  class HealthController {
    +Live(): HealthResponse
    +Ready(): Task<HealthResponse>
  }
  class ErrorCodeWriter {
    +TryHandleAsync(context, exception): bool
  }
  class CurrentPlayerFilter {
    +InvokeMethodAsync(context, next)
  }
  class RealTime <<static>> {
    +ServiceSetting = "Azure:SignalR:ConnectionString"
    +AddRealTime(services, configuration)
  }
  class RoomTokenAuthentication {
    +TokenClaim = "atw.room_token"
  }
  class SignalRServiceProbe
  class HubRateLimitFilter
}
package "Frontend — api library and game" {
  class ApiError <<type>> {
    +code: string
    +status: number
  }
  class "joinRefusal" as joinRefusal <<function>> {
    +(failure): JoinRefusal
  }
  class "roomRefusal" as roomRefusal <<function>> {
    +(failure): RoomRefusal
  }
  class GameErrorHandler {
    +handleError(error): void
  }
  class SomethingWentWrongPage
}
TelemetryBehavior ..> RefusedException : reads outcome code
TelemetryBehavior --> RequestTelemetry : records through
CheckReadinessQueryHandler ..> CheckReadinessQuery : handles
CheckReadinessQueryHandler --> "1..*" IReadinessProbe : asks
IReadinessProbe <|.. RoomStoreProbe
IReadinessProbe <|.. SignalRServiceProbe
IRoomNotifier <|.. HubRoomNotifier
HealthController ..> CheckReadinessQuery : sends
ErrorCodeWriter ..> RefusedException : writes code of
CurrentPlayerFilter ..> RefusedException : writes code of
CurrentPlayerFilter ..> RoomTokenAuthentication : reads the token claim of
RealTime ..> SignalRServiceProbe : registers when the service is set
RefusedException ..> ErrorCodes : holds one
ErrorCodeWriter ..> ApiError : becomes on the device
joinRefusal ..> ApiError : reads code of
roomRefusal ..> ApiError : reads code of
GameErrorHandler ..> SomethingWentWrongPage : opens
@enduml
