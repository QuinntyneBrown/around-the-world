@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Load lazily and release

interface GameSession {
  +tour: signal of TourState
  +duel: signal of DuelState
  +answer(value: number)
  +end()
}
class SoloGame {
  -agents: Map<player, ClassmateAgent>
  -playing: the one duel in play, or null
  -tour: Tour (one passport stamp a desk)
  +end()
}
class FriendsGame {
  -hub: RoomConnection
  -game: the last GameChanged only
  -receivedStickers: ReceivedSticker[] (3 at most)
  +end()
}
class StickerBuffer <<helper>> {
  {static} STICKERS_SHOWN = 3
  {static} STICKER_LASTS_MS = 2000
  +add(buffer, sticker)
  +showing(buffer, nowMs)
}
interface RoomConnection {
  +connect()
  +close()
}
class SignalRRoomConnection {
  -hub: HubConnection
  +close()
}
interface VoiceAnswer {
  +start()
  +stop()
}
class SpeechVoiceAnswer {
  -recognition
  -stream: MediaStream
  +stop()
}
interface ClassroomRenderer {
  +attach(canvas)
  +dispose()
}
class ThreeClassroomRenderer {
  -frame: requestAnimationFrame id
  +dispose()
}
class OnDeviceModelSession {
  +destroy()
}
class DuelPage {
  -destroyRef: DestroyRef
}
class HomePage {
  -destroyRef: DestroyRef
}
class WorldMapPage {
  -destroyRef: DestroyRef
}
GameSession <|.. SoloGame
GameSession <|.. FriendsGame
RoomConnection <|.. SignalRRoomConnection
VoiceAnswer <|.. SpeechVoiceAnswer
ClassroomRenderer <|.. ThreeClassroomRenderer
FriendsGame ..> StickerBuffer : keeps stickers with
SoloGame *-- "0..*" OnDeviceModelSession : destroys when the tour ends or is left
FriendsGame --> RoomConnection : closes when its route injector is destroyed
DuelPage ..> GameSession : reads
DuelPage ..> VoiceAnswer : stops on destroy
DuelPage ..> ClassroomRenderer : disposes on destroy
HomePage ..> ClassroomRenderer : disposes on destroy
WorldMapPage ..> ClassroomRenderer : disposes on destroy
WorldMapPage ..> GameSession : reads
@enduml
