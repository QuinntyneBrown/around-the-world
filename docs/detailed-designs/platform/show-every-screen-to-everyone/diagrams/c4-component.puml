@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show every screen to everyone

Container_Boundary(styles, "Global styles") {
  Component(tokens, "tokens", "CSS custom properties", "Focus ring, minimum target 44 px, colour pairs by role with measured contrast")
}
Container_Boundary(game, "game application") {
  Component(duel, "DuelPage", "Page", "Fills the screen and never scrolls; pad under the card below 768 px and beside it from 768 px; ring, pill of text or desk in the HUD; duel--banner and duel--pad for short screens")
  Component(pages, "HomePage, PickYourKidPage, LobbyPage, GameSetupPage, PodiumPage", "Pages", "One column below 992 px, two from 992 px")
  Component(pages768, "SoloOrFriendsPage, MicCheckPage", "Pages", "One column below 768 px, two from 768 px")
  Component(room, "RoomPage", "Page", "One centred column at every width, at most 576 px")
  Component(errors, "joinRefusal, roomRefusal", "Pure helpers", "Words for an error code")
  Component(dialogs, "Pause, Leave Game and Settings", "CDK Dialogs", "Hold the focus and return it; a sheet below 576 px, a centred card from 576 px")
}
Container_Boundary(components, "components library") {
  Component(bp, "breakpoints", "SCSS partial", "sm, md, lg and xl, the narrowest phones and Duel's heights, as named media queries")
  Component(skip, "SkipLink", "Presentation", "Focuses the main part without following its address")
  Component(choice, "ToggleChips, TableKeys, Choices, Segmented, KidPicker", "Presentation", "Native buttons with aria-pressed and a tick or a dot")
  Component(pad, "NumberPad", "Presentation", "Native buttons, 44 x 44 px or larger")
  Component(ring, "WorldRing", "Presentation", "Shown from 768 px, unless the height is under 544 px")
  Component(live, "Live regions", "role=status paragraphs, ToastRegion, StickerRegion, MapToast", "Visually hidden status; assertive on Duel")
  Component(alert, "Alert, StatusOverlay, FieldMessage", "Presentation", "role=alert, in words")
}
Rel(duel, dialogs, "Opens Pause or Leave Game")
Rel(pages, dialogs, "HomePage opens Settings")
Rel(dialogs, tokens, "Read focus ring and target size from")
Rel(duel, bp, "Places the pad by")
Rel(pages, bp, "Switch columns by")
Rel(pages768, bp, "Switch columns by")
Rel(room, alert, "Shows a refused code through")
Rel(duel, pad, "Composes")
Rel(duel, ring, "Shows from 768 px when not short")
Rel(pages, skip, "Start with")
Rel(duel, live, "Sends a flash card, a result and a freeze to")
Rel(pages, choice, "Compose")
Rel(pages, alert, "Show an error through")
Rel(errors, alert, "Supplies the words for")
Rel(choice, tokens, "Reads focus ring and target size from")
Rel(pad, tokens, "Reads focus ring and target size from")
@enduml
