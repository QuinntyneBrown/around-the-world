@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show every screen to everyone

class DuelPage {
  +announcement: computed string
  +padShown: computed boolean
  +notice: signal of ConnectionNotice
}
class "DuelWords" as DuelWords <<helper>> {
  +announcement(duel: DuelState): string
  +line(duel: DuelState): CardLine
}
class "ChoiceGroup" as ChoiceGroup <<ToggleChips, TableKeys, Choices, Segmented, KidPicker>> {
  +options: input
  +on: input
  +chosen: output
}
class Alert {
  +tone: input AlertTone
  +urgent: input boolean
}
class SkipLink {
  +target: input string
  -skip(event): focuses the target
}
class CodeField {
  +value: input string
  +entered: output
  -enter(field): reads the field itself
}
class NumberPad {
  +disabled: input boolean
  +keyPress: output
}
class WorldRing {
  +tourLength: input number
  +desk: input number
}
class "joinRefusal / roomRefusal" as refusal <<function>> {
  +(error): Refusal and its words
}
class "breakpoints" as bp <<SCSS partial>> {
  +from(band, height?)
  +below(band, height?)
  +between(from, below)
  +height(low | short)
  +narrow-phone
}
DuelPage ..> DuelWords : computes with
DuelPage --> NumberPad
DuelPage --> WorldRing : from md, when not short
DuelPage ..> bp : lays out by
Alert <.. refusal : words for
@enduml
