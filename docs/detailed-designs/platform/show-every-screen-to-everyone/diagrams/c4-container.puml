@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show every screen to everyone

Person(child, "Child", "Plays at any width, by touch or keyboard")
System_Ext(at, "Assistive technology", "Screen reader")
System_Boundary(atw, "Around the World") {
  Container(game, "game", "Angular application", "Pages: lay out each screen by breakpoint and compose announcements")
  Container(components, "components", "Angular library", "Presentation: native controls, aria-pressed, live regions, alerts, skip link; the breakpoints partial")
  Container(styles, "Global styles", "SCSS foundations", "Focus ring, minimum target size and colour tokens")
}
System_Boundary(tests, "Specs and sweeps") {
  Container(specs, "Behaviour specs and sweeps", "Playwright, axe-core", "Targets, Tab order, skip links, keyboard tours; responsive, accessibility and visual sweeps on request")
}
Rel(child, game, "Uses", "Touch, keyboard")
Rel(at, components, "Reads the accessibility tree of")
Rel(game, components, "Composes")
Rel(specs, game, "Drive in Chromium")
Rel(game, styles, "Uses tokens from")
Rel(game, components, "Uses breakpoints from")
Rel(components, styles, "Uses tokens from")
@enduml
