@startuml
title UML sequence behaviour — Play again or go Home from the Podium in a solo game
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Child" as child
box "Frontend — game application" #E0F2FE
  participant "PodiumPage" as page
  participant "SoloGame\n(GameSession)" as solo
  participant "DuelPage" as duel
  participant "HomePage" as home
end box
box "Frontend — domain library" #E0F2FE
  participant "Tour" as tour
end box
alt Play again in a solo game (L2-035 criterion 3)
  child -> page : Choose "Play again"
  page -> solo : playAgain()
  solo -> solo : Drop the ended tour, its timers and its result
  solo -> tour : start(the same tour length, the same kid's class)
  tour --> solo : A new tour
  solo --> duel : Screen duel, the first flash card (Mic Check is not shown again, L2-012 criterion 6)
  duel --> child : The first flash card of the new tour
else Home (L2-035 criterion 4)
  child -> page : Choose "Home"
  page -> home : Navigate to Home: leaving the solo group destroys SoloGame,\nits tour, its result and every timer
  home --> child : Home, with "Play again" (L2-032 criterion 2)
end
@enduml
