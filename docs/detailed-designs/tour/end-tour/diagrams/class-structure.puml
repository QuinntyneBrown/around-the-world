@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — End a tour

class Tour {
  +tourLength: number
  +{static} start(tourLength, traveller, seated, endsAtMs): Tour
  +applyDuel(winner: DuelSide, atMs: number): TourMove
  +ending(atMs: number): TourEnding | null
  +result(ending: TourEnding, own: string, shown: (player) => boolean): TourResult
}
class Standings {
  +reach(player: string, distance: number, atMs: number): void
  +ordered(): {player, distance}[]
}
class StandingsEntry {
  +place: number
  +player: string
  +distance: number
}
class TourResult {
  +ending: TourEnding
  +tourLength: number
  +winner: string
  +winnerDistance: number
  +places: StandingsEntry[]
  +players: TourPlayer[]
  +yourPlace: number
  +passport: PassportPage[]
  +countriesReached: number
}
enum TourEnding {
  allTheWayRound
  timeLimit
}
class PassportPage {
  +desk: number
  +country: string
  +stamped: boolean
}
class Passport {
  +stamp(desk: number): void
  +stamps: number[]
  +pages(countries: string[]): PassportPage[]
}
interface GameSession {
  +tour: Signal<TourState | null>
  +result: Signal<TourResult | null>
  +continue(): void
  +playAgain(): void
}
class SoloGame {
  -showMove(move: TourMove): void
  -finish(): void
  +playAgain(): void
}
class PodiumPage {
  -session: GameSession
  -visit: Visit
  #playAgain(): void
}
class PodiumWords {
  +headline(result): string
  +cheer(result): string
  +places(result): PodiumPlace[]
}

SoloGame ..|> GameSession
SoloGame *-- Tour
Tour *-- Standings
Tour *-- Passport
Tour ..> TourResult : builds
TourResult --> TourEnding
TourResult *-- StandingsEntry : places
TourResult *-- PassportPage
Passport ..> PassportPage : builds
PodiumPage ..> GameSession : injects GAME_SESSION
PodiumPage ..> PodiumWords
@enduml
