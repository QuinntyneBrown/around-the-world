@startuml
title UML sequence behaviour — Show the Lobby and keep it live
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Player" as actor
box "Frontend — game" #E0F2FE
  participant "LobbyPage" as page
  participant "FriendsGame" as session
end box
box "Frontend — api" #E0F2FE
  participant "RoomConnection" as conn
end box
box "Backend — AroundTheWorld.Api" #D1FADF
  participant "RoomHub" as hub
end box
box "Backend — AroundTheWorld.Application and Domain" #ECFDF3
  participant "ReconnectCommandHandler" as reconnect
  participant "LeaveRoomCommandHandler" as leave
  participant "Room" as room
end box
box "Backend — AroundTheWorld.Infrastructure" #FFF4E5
  database "Room store" as db
end box
actor -> page : Arrive from Solo Or Friends or Room
page -> session : Read the RoomState of the RoomEntry
session -> conn : Import the SignalR client and open with the token (L2-047 criterion 3)
conn -> hub : Connect, presenting the connection token
hub -> reconnect : Send ReconnectCommand
reconnect -> db : Load the room and player the token names
db --> reconnect : Room and RoomPlayer
reconnect --> hub : Place found, connection added to the room's group
hub --> conn : RoomChanged with the current RoomState
conn --> session : RoomState
session --> page : room signal
page --> actor : Code, players, Host, "(you)", count out of 8, empty desks (L2-024 criteria 1, 3)
page --> actor : Maths and tour from the setup; the line "Answer by: Shouting it!" (L2-024 criterion 5)
opt another player joins or leaves
  hub --> conn : RoomChanged pushed in the step that saved it
  conn --> session : RoomState
  session --> page : room signal
  page --> actor : The change within 1 second, no reload (L2-024 criterion 2)
  page --> actor : On a join, "{nickname} joined", "as {kid}" for 4 seconds (L2-024 criterion 6)
end
opt the player copies the room's link (L2-024 criterion 4)
  actor -> page : Choose "Copy room link"
  page -> page : Clipboard.copy(address of Room holding the code)
  alt the link is copied
    page --> actor : Message "Link copied", "Send it to a friend to get them in."
  else the link cannot be copied
    page --> actor : Alert "Couldn't copy the link", stays until dismissed
  end
end
opt the player leaves before the game starts
  actor -> page : Choose "Leave the room" (L2-030 criterion 8)
  page -> session : leave()
  session -> conn : leaveRoom()
  conn -> hub : LeaveRoom
  hub -> leave : Send LeaveRoomCommand
  leave -> db : Load the room
  db --> leave : Room
  leave -> room : Leave(player)
  alt the host left and players remain (L2-025 criterion 5)
    room --> leave : The player who joined earliest is the host
    leave -> db : Save changes
    leave -> hub : IRoomNotifier.RoomChanged
    hub --> conn : RoomChanged to the players who remain
    note over page, conn
      The new host's Lobby shows "You're the host now",
      "The host left. You can start the race."
    end note
  else the last player left (L2-025 criterion 5)
    room --> leave : Room is empty
    leave -> db : Delete the room
  end
  session -> conn : close() and remove handlers (L2-048 criterion 2)
  page --> actor : Solo Or Friends
end
opt the connection is lost and cannot be got back (L2-029 criterion 6)
  conn --> session : state closed
  session --> page : connection signal
  page --> actor : Alert "We lost the room"; "Try again", "Go home"
end
@enduml
