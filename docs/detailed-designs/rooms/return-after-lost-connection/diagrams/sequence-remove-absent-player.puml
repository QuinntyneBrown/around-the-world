@startuml
title UML sequence behaviour — Remove a player who has not returned
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Players who remain" as others
box "Frontend — game" #E0F2FE
  participant "DuelPage" as page
  participant "FriendsGame" as session
end box
box "Frontend — api" #E0F2FE
  participant "RoomConnection" as conn
end box
box "Backend — AroundTheWorld.Api" #D1FADF
  participant "RoomTimers" as timers
  participant "RoomHub" as hub
end box
box "Backend — AroundTheWorld.Application and Domain" #ECFDF3
  participant "RemoveAbsentPlayersCommandHandler" as handler
  participant "Room" as room
  participant "Tour" as tour
end box
box "Backend — AroundTheWorld.Infrastructure" #FFF4E5
  database "Room store" as db
end box
timers -> timers : Tick on TimeProvider
timers -> db : Find players whose AwaySince is 30 seconds old or more
db --> timers : Players away
timers -> handler : Send RemoveAbsentPlayersCommand(now)
handler -> db : Load the room
db --> handler : Room with its Tour
handler -> room : Remove(player, now)
alt the player returned in the meantime
  room --> handler : Nothing to remove
else the player is still away (L2-029 criterion 4)
  room -> tour : Leave(player): the desk stays empty (L2-007 criterion 6)
  alt nobody remains (L2-027 criterion 3)
    handler -> db : Delete the room and everything it held
  else two or more players remain
    tour --> room : The game continues without them
    handler -> db : Save changes in one unit of work
    handler -> hub : IRoomNotifier.RoomChanged
    hub --> conn : RoomChanged with the empty desk
    conn --> session : RoomState and TourState
    session --> page : room and tour signals
    page --> others : Banner "{nickname} dropped out.", "Their desk is empty now."; the game continues
  else fewer than two players remain (L2-029 criterion 5)
    room -> tour : End()
    tour --> room : Tour over
    handler -> db : Save changes in one unit of work
    handler -> hub : IRoomNotifier.GameChanged (ending everyoneLeft)
    hub --> conn : GameChanged to the player who remains
    conn --> session : Final TourState
    session --> page : tour signal
    page --> others : Banner "Everyone else has left.", "The tour ends here. On to the podium!"
    page --> others : Podium; the room is kept until this player leaves
  end
end
@enduml
