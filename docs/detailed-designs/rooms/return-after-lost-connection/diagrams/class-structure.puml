@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Return after a lost connection

enum RoomLink <<frontend, api>> {
  connecting
  live
  reconnecting
  lost
}
interface RoomEvents <<frontend, api>> {
  +changed(room: RoomState): void
  +gameChanged(game: GameState): void
  +reconnecting(): void
  +reconnected(): void
  +lost(): void
}
interface RoomConnection <<frontend, api>> {
  +connect(token: string, events: RoomEvents): Promise<void>
  +answer(value: number): Promise<void>
  +close(): Promise<void>
}
class SignalRRoomConnection <<frontend, api>> {
  -retry: at once, 1 s, then every 2 s, until 30 s
}
class FriendsGame <<frontend, game>> {
  +link: Signal<RoomLink>
  +connection: Signal<GameConnection>
  +notice: Signal<ConnectionNotice | null>
  -token: string (memory only)
  -lostAtMs: number | null
}
class StatusOverlay <<frontend, components>>
class ConnectionBanner <<frontend, components>>
class DuelPage <<frontend, game>>
class RoomHub {
  +OnConnectedAsync(): Task
  +OnDisconnectedAsync(error: Exception?): Task
}
class ReconnectCommandHandler
class MarkPlayerAwayCommandHandler
class RemoveAbsentPlayersCommand {
  +DateTimeOffset Now
}
class RemoveAbsentPlayersCommandHandler
class RoomTimers <<hosted service>> {
  -time: TimeProvider
}
class Room {
  +{static} TimeSpan SpotHeldFor = 30 s
  +Return(player: RoomPlayer, connectionId: string): void
  +MarkAway(player: RoomPlayer, connectionId: string, now: DateTimeOffset): bool
  +RemoveAbsent(now: DateTimeOffset, random: IRandomSource): IReadOnlyList<RoomPlayer>
}
class RoomPlayer {
  +ConnectionToken Token
  +string? ConnectionId
  +DateTimeOffset? AwaySince
  +IsAbsentAt(now: DateTimeOffset): bool
}
class RoomGame {
  +Remove(playerId: Guid, at: DateTimeOffset): void
  +EndAsEveryoneLeft(at: DateTimeOffset): void
}
class Tour {
  +Remove(player: string, at: DateTimeOffset): void
}

DuelPage ..> FriendsGame : reads connection and notice
DuelPage ..> StatusOverlay : shows
DuelPage ..> ConnectionBanner : shows
FriendsGame ..> RoomConnection : uses
FriendsGame --> RoomLink : reports
SignalRRoomConnection ..|> RoomConnection
RoomConnection ..> RoomEvents : tells
SignalRRoomConnection ..> RoomHub : connects with the token
RoomHub ..> ReconnectCommandHandler : ReconnectCommand on connect
RoomHub ..> MarkPlayerAwayCommandHandler : MarkPlayerAwayCommand on disconnect
RoomTimers ..> RemoveAbsentPlayersCommand : sends each tick
RemoveAbsentPlayersCommandHandler ..> RemoveAbsentPlayersCommand : handles
ReconnectCommandHandler --> Room : Return
MarkPlayerAwayCommandHandler --> Room : MarkAway
RemoveAbsentPlayersCommandHandler --> Room : RemoveAbsent
Room *-- "0..8" RoomPlayer
Room *-- "0..1" RoomGame
RoomGame *-- Tour
@enduml
