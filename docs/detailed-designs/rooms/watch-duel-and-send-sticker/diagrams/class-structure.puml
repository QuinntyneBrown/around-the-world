@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Watch a duel and send a sticker

class DuelPage <<frontend, game>> {
  #duel: Signal<DuelState | null>
  #stickers: Signal<ShownSticker[]>
  #send(id: StickerId): void
}
class StickerBar <<frontend, components>> {
  +stickers: InputSignal<StickerChoice[]>
  +chosen: OutputEmitterRef<StickerId>
}
class StickerRegion <<frontend, components>>
class StickerPop <<frontend, components>> {
  +kid, picture, words, from
}
class STICKERS <<frontend, domain>> {
  +id: StickerId (1 to 6)
  +words: string
  +kid: KidId | 'bolt'
}
interface GameSession <<frontend, api>> {
  +duel: Signal<DuelState | null>  (role 'watching')
  +stickers: Signal<ShownSticker[]>
  +sendSticker(id: StickerId): void
}
class FriendsGame <<frontend, game>> {
  -received: ShownSticker[] (at most 3, 2 s each on the game's clock)
}
class ShownSticker <<frontend, api>> {
  +key: number
  +sticker: StickerId
  +kid: KidId
  +from: string ("You" or the nickname)
}
interface RoomConnection <<frontend, api>> {
  +sendSticker(id: StickerId): Promise<void>
  events.stickerShown(sticker)
}
class RoomHub {
  +SendSticker(sticker: int): Task
}
class HubRateLimitFilter {
  +InvokeMethodAsync(context, next): ValueTask<object?>
  1 SendSticker a second, kept in the connection's Items
}
class SendStickerCommand {
  +int Sticker
}
class SendStickerCommandHandler {
  +Handle(command: SendStickerCommand): Task
}
class StickerId <<value object>> {
  +int Value
  +{static} TryParse(value: int, out id: StickerId): bool
}
class Room {
  +MaySendSticker(player: RoomPlayer): bool
}
class Duel {
  +string Traveller
  +string DeskHolder
  +Holds(player: string): bool
}
interface IRoomNotifier {
  +StickerShownAsync(roomId: Guid, sticker: StickerShownDto): Task
}

DuelPage --> StickerBar : shows while watching
DuelPage --> StickerRegion : shows received stickers in
StickerRegion o-- "0..3" StickerPop
DuelPage ..> STICKERS : words and pictures
DuelPage ..> GameSession : reads through GAME_SESSION
FriendsGame ..|> GameSession
FriendsGame *-- "0..3" ShownSticker
FriendsGame ..> RoomConnection : uses
RoomConnection ..> RoomHub : SendSticker / StickerShown
HubRateLimitFilter ..> RoomHub : filters
RoomHub ..> SendStickerCommand : sends
SendStickerCommandHandler ..> SendStickerCommand : handles
SendStickerCommandHandler ..> StickerId : parses
SendStickerCommandHandler ..> Room : asks whether the sender may
Room ..> Duel : asks who is duelling
SendStickerCommandHandler ..> IRoomNotifier : announces
@enduml
