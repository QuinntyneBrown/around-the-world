@startuml
title UML sequence behaviour — Watch a duel and send a sticker
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Watching player" as actor
actor "Every player in the room" as others
box "Frontend — game" #E0F2FE
  participant "DuelPage" as page
  participant "FriendsGame" as session
end box
box "Frontend — components" #E0F2FE
  participant "StickerBar" as tray
end box
box "Frontend — api" #E0F2FE
  participant "RoomConnection" as conn
end box
box "Backend — AroundTheWorld.Api" #D1FADF
  participant "HubRateLimitFilter" as limit
  participant "RoomHub" as hub
end box
box "Backend — AroundTheWorld.Application and Domain" #ECFDF3
  participant "SendStickerCommandHandler" as handler
  participant "Duel" as duel
end box
box "Backend — AroundTheWorld.Infrastructure" #FFF4E5
  database "Room store" as db
end box
session --> page : duel signal with the role watching (ADR 0035)
page --> actor : Flash card, who is duelling, timer bar, "Watching… your turn is next"; no number pad, no microphone (L2-028 criterion 1)
page -> tray : Show the six stickers: one for each kid, and Bolt, to confirm (L2-028 criteria 2, 6)
actor -> tray : Choose a sticker
tray --> page : chosen(StickerId)
page -> session : sendSticker(id)
session -> conn : sendSticker(id)
conn -> limit : SendSticker(id)
alt more than 1 sticker a second from this connection (L2-028 criterion 5)
  limit --> limit : Drop the message
else within the limit
  limit -> hub : Invoke SendSticker
  hub -> handler : Send SendStickerCommand
  handler -> handler : StickerId.TryParse(id)
  alt the id is not one of the six (L2-028 criterion 4)
    handler --> hub : Ignored
  else the id is one of the six
    handler -> db : Load the room the token names (RoomPlayerBehaviour)
    db --> handler : Room with its current Duel
    handler -> duel : Holds(sender)
    alt the sender is in the duel (L2-028 criterion 4)
      duel --> handler : true
      handler --> hub : Ignored
    else the sender is watching
      duel --> handler : false
      handler -> hub : IRoomNotifier.StickerShownAsync(sticker id, sender)
      hub --> conn : StickerShown to the whole room
      conn --> session : Sticker id and sender
      session -> session : Keep the newest 3, each for 2 seconds of the game's clock (ADR 0035)
      session --> page : stickers signal
      page --> others : The sticker with the sender's kid and name at the edge of Duel, newest at the bottom, about 2 seconds (L2-028 criteria 3, 7)
    end
  end
end
@enduml
