@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Decide the game on the server

Container_Boundary(game, "game and its libraries") {
  Component(pages, "DuelPage, WorldMapPage, PodiumPage", "Angular pages, game", "Show the game through GAME_SESSION")
  Component(session, "FriendsGame", "GameSession and RoomSession, game", "Keeps the last GameState and decides nothing")
  Component(view, "FriendsView", "Pure helper, game", "Turns the GameState into the duel, the tour, the result and the screen")
  Component(conn, "RoomConnection", "SignalR client, api", "One connection per player")
}
Container_Boundary(api, "AroundTheWorld.Api and its projects") {
  Component(hub, "RoomHub", "SignalR hub", "Each method sends one MediatR request")
  Component(timers, "RoomTimers", "Hosted service on TimeProvider", "Every 250 ms sends AdvanceGamesCommand")
  Component(answer, "SubmitAnswerCommandHandler", "MediatR handler", "Stamps the arrival, applies the answer, saves with the room's version")
  Component(advance, "AdvanceGamesCommandHandler", "MediatR handler", "Runs what fell due in each playing room")
  Component(again, "PlayAgainCommandHandler", "MediatR handler", "Returns the room to its Lobby")
  Component(game2, "RoomGame, Tour and Duel", "Domain", "The rules: first correct answer, freeze, hop, end; classmates at their pace; the shared table of cases")
  Component(maker, "FlashCardMaker", "Domain service", "Makes each flash card and keeps its answer")
  Component(notifier, "HubRoomNotifier", "IRoomNotifier, over RoomHub", "Pushes GameChanged and RoomChanged to the whole room in one step")
  ComponentDb(store, "Room store", "EF Core, Azure SQL Database", "The room, its game as one JSON column and GameDueAt")
}
Rel(pages, session, "Read state, submit an answer, play again")
Rel(session, view, "Asks what to show")
Rel(session, conn, "answer(number), playAgain(); listens to GameChanged")
Rel(conn, hub, "SubmitAnswer(number), PlayAgain()", "SignalR over WebSockets")
Rel(hub, answer, "Sends SubmitAnswerCommand")
Rel(hub, again, "Sends PlayAgainCommand")
Rel(timers, advance, "Sends AdvanceGamesCommand")
Rel(answer, game2, "Calls Answer on")
Rel(advance, game2, "Calls Advance on")
Rel(game2, maker, "Asks for the next flash card")
Rel(answer, store, "Loads and saves", "IAppDbContext")
Rel(advance, store, "Finds the rooms due, saves each", "IAppDbContext")
Rel(again, store, "Loads and saves", "IAppDbContext")
Rel(answer, notifier, "Announces the game")
Rel(advance, notifier, "Announces the game")
Rel(again, notifier, "Announces RoomChanged")
Rel(notifier, conn, "GameChanged, RoomChanged", "SignalR over WebSockets")
@enduml
