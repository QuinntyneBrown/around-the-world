@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Decide the game on the server

class RoomHub {
  +SaveSetup(setup: GameSetupDto): Task
  +StartGame(): Task
  +SubmitAnswer(answer: int): Task
  +PlayAgain(): Task
  +LeaveRoom(): Task
}
class SubmitAnswerCommand {
  +int Answer
}
class SubmitAnswerCommandValidator
class SubmitAnswerCommandHandler {
  +Handle(command: SubmitAnswerCommand): Task
}
class AdvanceGamesCommand {
  +DateTimeOffset Now
}
class AdvanceGamesCommandHandler {
  +Handle(command: AdvanceGamesCommand): Task<int>
}
class PlayAgainCommandHandler {
  +Handle(command: PlayAgainCommand): Task
}
class RoomTimers <<hosted service>> {
  -time: TimeProvider
}
class Room {
  +RoomStatus Status
  +GameSetup Setup
  +RoomGame? Game
  +DateTimeOffset? GameDueAt
  +Guid Version
  +Start(by: RoomPlayer, now): void
  +Answer(by: RoomPlayer, value: int, at, random): AnswerResult
  +AdvanceGame(now, random): bool
  +PlayAgain(now): bool
  +Leave(player: RoomPlayer, now): bool
}
class RoomGame {
  +GamePhase Phase
  +Tour Tour
  +Duel? Duel
  +List<GamePlayer> Players
  +List<PendingAnswer> Pending
  +DateTimeOffset? DueAt
  +Advance(now, random): bool
  +Answer(player, value, receivedAt, random): AnswerResult
  +Leave(player: Guid, at): void
}
class Tour {
  +List<string?> Holders
  +string Traveller
  +int Desk
  +ApplyDuel(winner: DuelSide, at): TourMove
  +Ending(at): TourEnding?
}
class Duel {
  +Card Card
  +string Traveller
  +string DeskHolder
  +Give(player, value, at): AnswerResult
  +TimeOut(): bool
}
class Card {
  +MathsKind Kind
  +int Left
  +int Right
  +Answer(): int
}
class FlashCardMaker {
  +Next(kinds, tables, last: Card?, random): Card
}
enum AnswerResult {
  Ignored
  Wrong
  Won
}
interface IRoomNotifier {
  +RoomChangedAsync(roomId, room: RoomStateDto): Task
  +GameChangedAsync(roomId, game: GameStateDto): Task
}
class GameStateDto <<sent to players>> {
  +GameDuelDto? Duel
  +the card without its answer while open
}
interface GameSession <<frontend, api>> {
  +duel: Signal<DuelState>
  +tour: Signal<TourState>
  +answer(value: number): void
  +playAgain(): void
  +leave(): Promise<void>
}
class FriendsGame <<frontend, game>>
class FriendsView <<frontend, game>>

RoomHub ..> SubmitAnswerCommand : sends
SubmitAnswerCommandValidator ..> SubmitAnswerCommand : validates 0 to 999
SubmitAnswerCommandHandler ..> SubmitAnswerCommand : handles
SubmitAnswerCommandHandler --> Room : loads / mutates
SubmitAnswerCommandHandler ..> IRoomNotifier : announces
PlayAgainCommandHandler --> Room : loads / mutates
RoomTimers ..> AdvanceGamesCommand : sends
AdvanceGamesCommandHandler ..> AdvanceGamesCommand : handles
AdvanceGamesCommandHandler --> Room : loads / mutates
Room *-- "0..1" RoomGame : one at a time
RoomGame *-- "1" Tour
RoomGame *-- "0..1" Duel : the last card's
Duel *-- "1" Card
RoomGame ..> FlashCardMaker : asks for the next card
Duel ..> AnswerResult : returns
IRoomNotifier ..> GameStateDto : sends
FriendsGame ..|> GameSession
FriendsGame ..> FriendsView : shows through
FriendsGame ..> RoomHub : through RoomConnection
@enduml
