@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Join a room

Container_Boundary(game, "game and its libraries") {
  Component(page, "RoomPage", "Angular page, game", "Holds the code, the Join button and the refusal messages")
  Component(boxes, "CodeBoxes", "Presentation component, components", "The code-field block: four boxes that take letters only and show capitals")
  Component(client, "RoomsApi", "HTTP client, api", "Sends the request and returns a RoomEntry or an ApiError")
  Component(session, "FriendsGame", "Game service, game", "Keeps the code, the connection token and the RoomState in memory")
}
Container_Boundary(api, "AroundTheWorld.Api and its projects") {
  Component(ctrl, "RoomsController", "ASP.NET Core controller", "Open to anyone, rate limited, sends one request")
  Component(validator, "JoinRoomCommandValidator", "FluentValidation", "Checks the code, the kid id and the nickname indexes")
  Component(handler, "JoinRoomCommandHandler", "MediatR handler", "Finds the room by its code and adds the player")
  Component(room, "Room", "Domain entity", "Refuses a full room and a started game")
  Component(notifier, "IRoomNotifier", "Port, implemented over RoomHub", "Pushes the changed room to its players")
  ComponentDb(store, "Room store", "EF Core, engine to supply", "Persists the room")
}
Rel(page, boxes, "Shows and reads the code from")
Rel(page, client, "Calls joinRoom")
Rel(page, session, "Hands the RoomEntry to")
Rel(client, ctrl, "POST /rooms/join", "JSON/HTTPS")
Rel(ctrl, handler, "Sends JoinRoomCommand")
Rel(validator, handler, "Runs before")
Rel(handler, room, "Calls Join on")
Rel(handler, store, "Loads and saves", "IAppDbContext")
Rel(handler, notifier, "Announces RoomChanged")
@enduml
