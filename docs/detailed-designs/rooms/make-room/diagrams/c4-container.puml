@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Make a room

Person(child, "Child", "Becomes the host of the room made")
System_Boundary(atw, "Around the World") {
  Container(game, "game", "Angular application", "Solo Or Friends and the Lobby")
  Container(api, "AroundTheWorld.Api", "ASP.NET Core", "Makes the room, its code and its host")
  ContainerDb(store, "Room store", "EF Core, engine to supply", "Rooms, their players and setup")
}
Rel(child, game, "Chooses Make a room", "HTTPS")
Rel(game, api, "Asks for a room", "JSON/HTTPS")
Rel(api, store, "Saves the room", "EF Core")
@enduml
