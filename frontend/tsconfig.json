{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@atw/api": ["./projects/api/src/public-api.ts"],
      "@atw/domain": ["./projects/domain/src/public-api.ts"],
      "@atw/components": ["./projects/components/src/public-api.ts"],
      "@atw/world": ["./projects/world/src/public-api.ts"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "typeCheckHostBindings": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/game/tsconfig.app.json"
    },
    {
      "path": "./projects/game/tsconfig.spec.json"
    },
    {
      "path": "./projects/api/tsconfig.lib.json"
    },
    {
      "path": "./projects/api/tsconfig.spec.json"
    },
    {
      "path": "./projects/domain/tsconfig.lib.json"
    },
    {
      "path": "./projects/domain/tsconfig.spec.json"
    },
    {
      "path": "./projects/components/tsconfig.lib.json"
    },
    {
      "path": "./projects/components/tsconfig.spec.json"
    },
    {
      "path": "./projects/world/tsconfig.lib.json"
    },
    {
      "path": "./projects/world/tsconfig.spec.json"
    }
  ]
}
