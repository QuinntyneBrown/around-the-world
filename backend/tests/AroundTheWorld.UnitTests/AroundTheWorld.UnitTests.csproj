<Project Sdk="Microsoft.NET.Sdk">
  <!-- Direct tests of a rule with a table of cases, one case per row (AGENTS.md, Backend tests).
       They run locally with tools/verify/verify.mjs, never in CI (docs/adr/0031). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AroundTheWorld.Infrastructure\AroundTheWorld.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
