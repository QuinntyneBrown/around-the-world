root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[*.{csproj,props,targets,slnx,json}]
indent_style = space
indent_size = 2

# Test names read as Given_when_then sentences.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
# xUnit test classes are discovered by reflection and need not be sealed or static.
dotnet_diagnostic.CA1515.severity = none

# EF Core writes the migrations; they are generated code, not formatted by hand.
[src/AroundTheWorld.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
